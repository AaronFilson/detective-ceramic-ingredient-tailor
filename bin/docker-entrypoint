#!/bin/bash -e

# Enable jemalloc for reduced memory usage and fragmentation on both arm64 (aarch64) and amd64 (x86_64).
if [ -z "${LD_PRELOAD+x}" ]; then
  for candidate in /usr/lib/*-linux-gnu/libjemalloc.so.2; do
    if [ -f "$candidate" ]; then
      export LD_PRELOAD="$candidate"
      break
    fi
  done
fi

# If running the rails server (directly or via Thruster), prepare or migrate existing database.
if [ "${1:-}" = "./bin/thrust" ] || [ "${1:-}" = "bin/thrust" ] || \
   { { [ "${1:-}" = "./bin/rails" ] || [ "${1:-}" = "bin/rails" ]; } && [ "${2:-}" = "server" ]; }; then
  ./bin/rails db:prepare
fi

exec "${@}"
