<% heuristic_assay = local_assigns.fetch(:heuristic_assay, sample&.latest_heuristic_assay_result) %>
<% verified_lab_assay = local_assigns.fetch(:verified_lab_assay, sample&.latest_verified_lab_assay) %>
<% lab_errors = Array(local_assigns[:lab_errors]).compact %>

<div id="lab_calibration_panel" class="space-y-4">
  <% if sample&.persisted? %>
    <% if verified_lab_assay.present? %>
      <% badge = source_type_badge(verified_lab_assay.source_type) %>
      <% comparison = Lab::VerifiedAssayImporter.compare(heuristic_assay, verified_lab_assay) %>
      <% is_pxrf = verified_lab_assay.analysis_method == "pxrf" %>
      <% minor_oxides = verified_lab_assay.minor_oxides.is_a?(Hash) ? verified_lab_assay.minor_oxides.select { |_, v| v.to_f.positive? } : {} %>
      <% trace_ppm = verified_lab_assay.trace_elements_ppm.is_a?(Hash) ? verified_lab_assay.trace_elements_ppm.select { |_, v| v.to_f.positive? } : {} %>

      <div class="rounded-xl border border-emerald-800/25 bg-[#FCFBF8] p-4 space-y-4 shadow-xs" data-verified-lab-card>
        <div class="flex flex-wrap items-start justify-between gap-3 pb-3 border-b border-[#E8DFD0]">
          <div class="space-y-1.5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold border <%= badge[:classes] %>">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                <%= badge[:label] %>
              </span>

              <% if is_pxrf %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-950 border border-amber-300" data-pxrf-badge>
                  Handheld pXRF
                </span>
              <% end %>

              <% if verified_lab_assay.promoted_to_reference? %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-[#1E4E79]/10 text-[#1E4E79] border border-[#1E4E79]/25">
                  Promoted to Spatial Atlas
                </span>
                <% if verified_lab_assay.reference_assay&.coordinate_privacy == "fuzzed_2km" %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-900 border border-amber-300" data-atlas-fuzzed-badge>
                    ~2 km Fuzzed GPS
                  </span>
                <% end %>
              <% end %>
            </div>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-stone-700">
              <% if verified_lab_assay.lab_name.present? %>
                <span>Lab: <strong class="text-stone-900"><%= verified_lab_assay.lab_name %></strong></span>
              <% end %>
              <% if verified_lab_assay.lab_report_ref.present? %>
                <span class="font-mono text-[11px] text-stone-600">Ref: <%= verified_lab_assay.lab_report_ref %></span>
              <% end %>
              <span class="font-mono text-[11px] text-stone-500">
                Logged <%= verified_lab_assay.created_at.strftime("%Y-%m-%d %H:%M") %>
              </span>
            </div>
          </div>

          <%= button_to "Remove",
            sample_lab_assay_path(sample, verified_lab_assay),
            method: :delete,
            form: { data: { turbo: true, turbo_confirm: "Remove this verified lab assay?" } },
            class: "inline-flex items-center px-3 py-1.5 rounded-lg border border-red-200 bg-white hover:bg-red-50 text-red-800 text-xs font-semibold transition-colors cursor-pointer" %>
        </div>

        <% if minor_oxides.any? || trace_ppm.any? %>
          <div class="rounded-xl border border-[#E8DFD0] bg-[#FAF7F2] px-3 py-2.5 space-y-2" data-lab-minor-trace-summary>
            <% if minor_oxides.any? %>
              <div class="flex flex-wrap items-center gap-1.5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-stone-500 mr-1">Minor Oxides:</span>
                <% minor_oxides.each do |ox, val| %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white border border-[#D6C7B2] font-mono text-[11px] text-stone-800">
                    <strong><%= ox %></strong>
                    <span><%= format("%.2f%%", val.to_f) %></span>
                  </span>
                <% end %>
              </div>
            <% end %>
            <% if trace_ppm.any? %>
              <div class="flex flex-wrap items-center gap-1.5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-stone-500 mr-1">Trace (ppm):</span>
                <% trace_ppm.first(12).each do |el, ppm| %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white border border-stone-200 font-mono text-[11px] text-stone-700">
                    <strong><%= el %></strong>
                    <span><%= ppm.to_f >= 100 ? ppm.to_f.round : format("%.1f", ppm.to_f).sub(/\.0\z/, "") %></span>
                  </span>
                <% end %>
                <% if trace_ppm.size > 12 %>
                  <span class="font-mono text-[10px] text-stone-500">+<%= trace_ppm.size - 12 %> more</span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if comparison.present? %>
          <%= render "lab_assays/comparison_table",
            comparison: comparison,
            heuristic_assay: heuristic_assay,
            verified_lab_assay: verified_lab_assay %>
        <% else %>
          <p class="text-xs text-stone-600">
            Verified lab chemistry is active. Run a spatial heuristic estimate to compare predicted vs. measured oxide residuals.
          </p>
        <% end %>
      </div>
    <% end %>

    <details class="rounded-xl border border-[#D6C7B2] bg-[#FCFBF8] overflow-hidden" <%= "open" if lab_errors.any? || current_studio_setting.has_pxrf_workflow? %>>
      <summary class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 bg-[#FAF7F2] hover:bg-[#F3ECE0]/70 cursor-pointer select-none transition-colors">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-stone-800">
            Log Verified Lab Assay (XRF / ICP-MS / Handheld pXRF)
          </div>
          <div class="text-[11px] text-stone-500">
            Upload WSU, Actlabs, Orton, or Bruker/Olympus/Niton pXRF CSV (with Studio Kiln LOI) or enter Wt % oxides
          </div>
        </div>
        <span class="inline-flex items-center px-2.5 py-1 rounded-lg border border-[#D6C7B2] bg-white text-[11px] font-semibold text-[#1E4E79]">
          <%= verified_lab_assay.present? ? "Upload New Report" : "+ Add Lab / pXRF Assay" %>
        </span>
      </summary>

      <div class="p-4 border-t border-[#E8DFD0] space-y-4">
        <% if lab_errors.any? %>
          <div class="rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs text-red-900" role="alert">
            <div class="font-semibold mb-1">Could not import verified lab assay:</div>
            <ul class="list-disc pl-4 space-y-0.5">
              <% lab_errors.each do |err| %>
                <li><%= err %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with scope: :lab_assay,
          url: sample_lab_assays_path(sample),
          method: :post,
          multipart: true,
          data: { turbo: true },
          class: "space-y-4" do |f| %>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <%= f.label :source_type, "Analytical Method", class: "block text-[11px] font-semibold text-stone-600 mb-1" %>
              <%= f.select :source_type,
                options_for_select(
                  [
                    [ "Verified Lab XRF", "verified_lab_xrf" ],
                    [ "Verified Lab ICP-MS", "verified_lab_icpms" ],
                    [ "Handheld pXRF CSV (Bruker / Olympus / Niton)", "pxrf" ]
                  ],
                  current_studio_setting.has_pxrf_workflow? ? "pxrf" : "verified_lab_xrf"
                ),
                {},
                class: "w-full rounded-xl border border-[#D6C7B2] bg-white px-3 py-2 text-xs font-medium text-stone-900 focus:outline-none focus:ring-2 focus:ring-[#1E4E79]/40 focus:border-[#1E4E79]" %>
            </div>

            <div>
              <%= f.label :lab_name, "Laboratory / Instrument Name", class: "block text-[11px] font-semibold text-stone-600 mb-1" %>
              <%= f.text_field :lab_name,
                placeholder: "e.g., WSU GeoAnalytical, Bruker S1 TITAN",
                class: "w-full rounded-xl border border-[#D6C7B2] bg-white px-3 py-2 text-xs text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-[#1E4E79]/40 focus:border-[#1E4E79]" %>
            </div>

            <div>
              <%= f.label :lab_report_ref, "Lab Report / Sample Ref", class: "block text-[11px] font-semibold text-stone-600 mb-1" %>
              <%= f.text_field :lab_report_ref,
                placeholder: "e.g., WSU-2026-0412 or PEG-01",
                class: "w-full rounded-xl border border-[#D6C7B2] bg-white px-3 py-2 font-mono text-xs text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-[#1E4E79]/40 focus:border-[#1E4E79]" %>
            </div>
          </div>

          <div class="rounded-xl border border-dashed border-[#D6C7B2] bg-[#FAF7F2] p-3.5 space-y-1.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <%= f.label :csv_file, "Upload Lab or Handheld pXRF CSV / TSV Report", class: "text-xs font-bold uppercase tracking-wider text-stone-700" %>
              <span class="text-[11px] text-stone-500">WSU · Actlabs · Orton · Bruker · Olympus · Niton</span>
            </div>
            <%= f.file_field :csv_file,
              accept: ".csv,.tsv,.txt",
              class: "block w-full text-xs text-stone-700 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border file:border-[#D6C7B2] file:text-xs file:font-semibold file:bg-white file:text-[#1E4E79] hover:file:bg-stone-50 cursor-pointer" %>
            <p class="text-[11px] text-stone-500">
              Lab mode converts FeO/FeOT to Fe2O3; Handheld pXRF mode parses elemental %/ppm columns, computes minor oxides, captures trace ppm + K/Rb pathfinder signals, and runs safety screening.
            </p>
          </div>

          <div class="rounded-xl border border-[#D6C7B2] bg-[#FAF7F2] p-3.5 space-y-2.5" data-studio-kiln-loi-calculator>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-stone-700">
                Studio Kiln LOI Calculator (Optional · Recommended for pXRF)
              </span>
              <span class="font-mono text-[10px] text-[#1E4E79]">
                LOI % = (Dry − Fired) / Dry × 100
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <div>
                <%= f.label :dry_weight_g, "Bone-Dry Weight (g)", class: "block text-[11px] font-semibold text-stone-600 mb-1" %>
                <%= f.number_field :dry_weight_g,
                  step: "0.01",
                  min: 0,
                  placeholder: "e.g., 100.00",
                  class: "w-full rounded-lg border border-[#D6C7B2] bg-white px-2.5 py-1.5 font-mono text-xs tabular-nums text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-[#1E4E79]/40 focus:border-[#1E4E79]" %>
              </div>

              <div>
                <%= f.label :fired_weight_g, "Fired Weight (g)", class: "block text-[11px] font-semibold text-stone-600 mb-1" %>
                <%= f.number_field :fired_weight_g,
                  step: "0.01",
                  min: 0,
                  placeholder: "e.g., 91.50",
                  class: "w-full rounded-lg border border-[#D6C7B2] bg-white px-2.5 py-1.5 font-mono text-xs tabular-nums text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-[#1E4E79]/40 focus:border-[#1E4E79]" %>
              </div>

              <div>
                <%= f.label :measured_loi_pct, "Or Direct Measured LOI (%)", class: "block text-[11px] font-semibold text-stone-600 mb-1" %>
                <%= f.number_field :measured_loi_pct,
                  step: "0.01",
                  min: 0,
                  max: 99.9,
                  placeholder: "e.g., 8.50",
                  class: "w-full rounded-lg border border-[#D6C7B2] bg-white px-2.5 py-1.5 font-mono text-xs tabular-nums text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-[#1E4E79]/40 focus:border-[#1E4E79]" %>
              </div>
            </div>

            <p class="text-[11px] text-stone-500">
              Handheld pXRF cannot detect volatiles (H2O, CO2, organics). Entering kiln test weights preserves exact measured LOI and lifts pXRF confidence from 82% to 90%.
            </p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-stone-700">
                Or Enter Oxide Wt % Manually (Lab XRF / ICP-MS)
              </span>
              <span class="text-[11px] text-stone-500">Normalized to exact 100.00%</span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-2">
              <% CeramicOxides::KEYS.each do |oxide| %>
                <div class="rounded-lg border border-[#E8DFD0] bg-white px-2.5 py-2">
                  <label
                    for="lab_assay_oxides_<%= oxide.downcase %>"
                    class="block font-mono text-[11px] font-bold text-stone-700 mb-1"
                  >
                    <%= oxide %>
                  </label>
                  <%= number_field_tag "lab_assay[oxides][#{oxide}]",
                    nil,
                    id: "lab_assay_oxides_#{oxide.downcase}",
                    step: "0.01",
                    min: 0,
                    max: 100,
                    placeholder: "0.00",
                    class: "w-full rounded-md border border-[#D6C7B2] bg-[#FCFBF8] px-2 py-1 font-mono text-xs tabular-nums text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-[#B84A27]/35 focus:border-[#B84A27]" %>
                </div>
              <% end %>
            </div>
          </div>

          <% selected_privacy = params.dig(:lab_assay, :coordinate_privacy).to_s == "fuzzed_2km" ? "fuzzed_2km" : "exact" %>
          <% promote_checked = ActiveModel::Type::Boolean.new.cast(params.dig(:lab_assay, :promote_to_reference)) %>

          <div class="rounded-xl border border-[#D6C7B2] bg-[#FAF7F2] p-3.5 space-y-3" data-atlas-promotion-privacy>
            <input type="hidden" name="lab_assay[privacy_prompt_shown]" value="1">

            <label class="flex items-start gap-2.5 cursor-pointer">
              <%= f.check_box :promote_to_reference,
                { checked: promote_checked, class: "mt-0.5 rounded border-[#D6C7B2] text-[#1E4E79] focus:ring-[#1E4E79]" },
                "1",
                "0" %>
              <span class="space-y-0.5">
                <span class="block text-xs font-semibold text-stone-900">
                  Contribute to Regional Spatial Atlas (2.5x weighted calibration prior)
                </span>
                <span class="block text-[11px] text-stone-500">
                  <% if sample.latitude.present? && sample.longitude.present? %>
                    Publishes this verified assay for (<%= format("%.4f, %.4f", sample.latitude.to_f, sample.longitude.to_f) %>) to improve future spatial baseline predictions.
                  <% else %>
                    Add GPS coordinates to this sample in Step 1 to publish into the Regional Spatial Atlas.
                  <% end %>
                </span>
              </span>
            </label>

            <fieldset class="pl-6 space-y-2 border-t border-[#E8DFD0] pt-2.5">
              <legend class="text-[11px] font-bold uppercase tracking-wider text-stone-700 mb-1">
                Dig-Site Coordinate Privacy
              </legend>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <label class="flex items-start gap-2 rounded-lg border border-[#D6C7B2] bg-white px-3 py-2 cursor-pointer hover:border-[#1E4E79]">
                  <input
                    type="radio"
                    name="lab_assay[coordinate_privacy]"
                    value="exact"
                    <%= "checked" if selected_privacy == "exact" %>
                    class="mt-0.5 text-[#1E4E79] focus:ring-[#1E4E79]"
                  >
                  <span class="space-y-0.5">
                    <span class="block text-xs font-semibold text-stone-900">Exact GPS Coordinates (Default)</span>
                    <span class="block text-[11px] text-stone-500 leading-snug">
                      Publishes exact sample coordinates for public geological roadcuts and outcrops.
                    </span>
                  </span>
                </label>

                <label class="flex items-start gap-2 rounded-lg border border-[#D6C7B2] bg-white px-3 py-2 cursor-pointer hover:border-[#B84A27]">
                  <input
                    type="radio"
                    name="lab_assay[coordinate_privacy]"
                    value="fuzzed_2km"
                    <%= "checked" if selected_privacy == "fuzzed_2km" %>
                    class="mt-0.5 text-[#B84A27] focus:ring-[#B84A27]"
                  >
                  <span class="space-y-0.5">
                    <span class="block text-xs font-semibold text-stone-900">Fuzz Coordinates (~2 km privacy offset)</span>
                    <span class="block text-[11px] text-stone-500 leading-snug">
                      Deterministic ~2 km offset protecting private wild-clay sites while preserving regional formation chemistry.
                    </span>
                  </span>
                </label>
              </div>

              <label class="flex items-start gap-2 pt-1 cursor-pointer">
                <%= check_box_tag "lab_assay[atlas_privacy_confirmed]",
                  "1",
                  false,
                  id: "lab_assay_atlas_privacy_confirmed",
                  class: "mt-0.5 rounded border-[#D6C7B2] text-[#1E4E79] focus:ring-[#1E4E79]" %>
                <span class="text-[11px] font-medium text-stone-700">
                  Confirm coordinate privacy selection above before publishing to the shared Atlas
                </span>
              </label>
            </fieldset>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
            <%= f.submit "Save Verified Lab Assay",
              class: "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-[#1E4E79] hover:bg-[#163B5C] text-white text-xs font-semibold shadow-sm transition-colors cursor-pointer" %>
            <span class="text-[11px] text-stone-500">
              Computes Seger UMF, hazard screening &amp; heuristic residual error live
            </span>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
