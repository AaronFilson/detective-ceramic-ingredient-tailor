<% content_for :title, "Reset Password — DCI Tailor" %>

<div class="min-h-screen flex flex-col bg-[#F5F0E6]">
  <header class="shrink-0 bg-[#1F1B18] text-[#FAF7F2] border-b border-stone-800 px-4 sm:px-5 py-2.5 flex items-center justify-between gap-3">
    <%= link_to root_path, class: "flex items-center gap-2.5 group focus:outline-none" do %>
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#B84A27] text-[#FAF7F2] shadow-inner font-mono text-xs font-bold tracking-tight group-hover:bg-[#C85A32] transition-colors">
        SiO₂
      </span>
      <div class="leading-tight">
        <div class="font-semibold tracking-tight text-sm sm:text-base text-[#FAF7F2]">DCI Tailor</div>
        <div class="text-[11px] text-stone-400">Detective Ceramic Ingredient Tailor · Password Recovery</div>
      </div>
    <% end %>

    <%= link_to "← Back to Sign In",
      new_session_path,
      class: "px-3 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-200 border border-stone-700 text-xs font-medium transition-colors" %>
  </header>

  <main class="flex-1 flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-md rounded-2xl bg-[#FCFBF8] border border-[#D6C7B2] shadow-lg overflow-hidden">
      <div class="px-6 py-4 bg-[#FAF7F2] border-b border-[#E8DFD0]">
        <span class="font-mono text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[#1E4E79]/12 text-[#1E4E79] border border-[#1E4E79]/20">
          Password Reset
        </span>
        <h1 class="mt-1.5 text-lg font-bold text-stone-900 tracking-tight">Forgot your studio password?</h1>
        <p class="text-xs text-stone-600 mt-0.5">
          Enter your studio email address and we will send a 30-minute password reset link.
        </p>
      </div>

      <div class="p-6 space-y-4">
        <% if flash[:alert].present? %>
          <div class="rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs text-red-900" role="alert">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <%= form_with scope: :password, url: passwords_path, method: :post, class: "space-y-4" do |f| %>
          <div>
            <%= f.label :email, "Email Address", class: "block text-xs font-semibold text-stone-700 mb-1" %>
            <%= f.email_field :email,
              required: true,
              autofocus: true,
              autocomplete: "email",
              placeholder: "potter@studio.example",
              class: "w-full rounded-xl border border-[#D6C7B2] bg-white px-3.5 py-2 text-sm text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-[#1E4E79]/40 focus:border-[#1E4E79]" %>
          </div>

          <%= f.submit "Email Reset Instructions",
            class: "w-full py-2.5 px-4 rounded-xl bg-[#1E4E79] hover:bg-[#163B5C] text-[#FAF7F2] text-sm font-semibold shadow-sm transition-colors cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </main>
</div>
