<% content_for :title, "Choose New Password — DCI Tailor" %>

<div class="min-h-screen flex flex-col bg-[#F5F0E6]">
  <header class="shrink-0 bg-[#1F1B18] text-[#FAF7F2] border-b border-stone-800 px-4 sm:px-5 py-2.5 flex items-center justify-between gap-3">
    <%= link_to root_path, class: "flex items-center gap-2.5 group focus:outline-none" do %>
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#B84A27] text-[#FAF7F2] shadow-inner font-mono text-xs font-bold tracking-tight group-hover:bg-[#C85A32] transition-colors">
        SiO₂
      </span>
      <div class="leading-tight">
        <div class="font-semibold tracking-tight text-sm sm:text-base text-[#FAF7F2]">DCI Tailor</div>
        <div class="text-[11px] text-stone-400">Detective Ceramic Ingredient Tailor · Choose New Password</div>
      </div>
    <% end %>
  </header>

  <main class="flex-1 flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-md rounded-2xl bg-[#FCFBF8] border border-[#D6C7B2] shadow-lg overflow-hidden">
      <div class="px-6 py-4 bg-[#FAF7F2] border-b border-[#E8DFD0]">
        <span class="font-mono text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[#B84A27]/12 text-[#963B1D] border border-[#B84A27]/20">
          Password Update
        </span>
        <h1 class="mt-1.5 text-lg font-bold text-stone-900 tracking-tight">Choose a new studio password</h1>
        <p class="text-xs text-stone-600 mt-0.5">
          Updating password for <strong><%= @user.email %></strong>.
        </p>
      </div>

      <div class="p-6 space-y-4">
        <% if @user&.errors&.any? %>
          <div class="rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs text-red-900" role="alert">
            <ul class="list-disc pl-4 space-y-0.5">
              <% @user.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @user, url: password_path(@token), method: :patch, class: "space-y-4" do |f| %>
          <div>
            <%= f.label :password, "New Password (min. 8 characters)", class: "block text-xs font-semibold text-stone-700 mb-1" %>
            <%= f.password_field :password,
              required: true,
              minlength: 8,
              autofocus: true,
              autocomplete: "new-password",
              class: "w-full rounded-xl border border-[#D6C7B2] bg-white px-3.5 py-2 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-[#B84A27]/40 focus:border-[#B84A27]" %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirm New Password", class: "block text-xs font-semibold text-stone-700 mb-1" %>
            <%= f.password_field :password_confirmation,
              required: true,
              minlength: 8,
              autocomplete: "new-password",
              class: "w-full rounded-xl border border-[#D6C7B2] bg-white px-3.5 py-2 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-[#B84A27]/40 focus:border-[#B84A27]" %>
          </div>

          <%= f.submit "Save New Password",
            class: "w-full py-2.5 px-4 rounded-xl bg-[#B84A27] hover:bg-[#963B1D] text-[#FAF7F2] text-sm font-semibold shadow-sm transition-colors cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </main>
</div>
