<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "DCI Tailor — Detective Ceramic Ingredient Tailor" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="DCI Tailor">
    <meta name="mobile-web-app-capable" content="yes">
    <% if ENV["NOINDEX"] == "1" || ENV["SITE_LABEL"].to_s.casecmp?("staging") %>
      <meta name="robots" content="noindex, nofollow">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Leaflet 1.9.4 CSS & JS for interactive geological map + Macrostrat tile overlay %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

    <%# Includes compiled Tailwind + application stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen lg:h-screen lg:overflow-hidden bg-[#F5F0E6] text-stone-900 antialiased flex flex-col selection:bg-[#B84A27]/20 selection:text-stone-900">
    <% if ENV["SITE_LABEL"].to_s.casecmp?("staging") %>
      <div role="status" data-staging-banner class="bg-amber-200 border-b border-amber-400 text-amber-950 px-3 py-1 text-center text-xs font-semibold tracking-wide shrink-0">
        Staging copy — test data only (dci-tailor-staging.glazecalcapp.com)
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
