<div id="field_observation_history">
  <% observations = sample.field_observations
    .with_attached_raw_tile_photo
    .with_attached_fired_tile_photo
    .order(created_at: :desc, id: :desc)
    .limit(4) %>
  <% if observations.any? %>
    <div class="pt-3 border-t border-[#E8DFD0] space-y-2">
      <div class="text-[11px] font-bold uppercase tracking-wider text-stone-500">
        Recent Diagnostic Log (<%= sample.field_observations.count %>)
      </div>
      <div class="space-y-1.5">
        <% observations.each do |obs| %>
          <% fit_badges = body_fit_assessment(obs) %>
          <% has_raw_photo = obs.raw_tile_photo.attached? && obs.raw_tile_photo.attachment&.persisted? && obs.raw_tile_photo.blob&.persisted? %>
          <% has_fired_photo = obs.fired_tile_photo.attached? && obs.fired_tile_photo.attachment&.persisted? && obs.fired_tile_photo.blob&.persisted? %>
          <div class="rounded-lg bg-[#FAF7F2] border border-[#E8DFD0] px-3 py-2 text-[11px] text-stone-700 space-y-1.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap items-center gap-1.5">
                <span class="px-1.5 py-0.5 rounded bg-white border border-stone-200 font-semibold">
                  Fizz: <%= obs.vinegar_fizz %>
                </span>
                <% if obs.slaking_behavior.present? %>
                  <span class="px-1.5 py-0.5 rounded bg-white border border-stone-200">
                    Slake: <%= obs.slaking_behavior.humanize %>
                  </span>
                <% end %>
                <% if obs.plasticity.present? %>
                  <span class="px-1.5 py-0.5 rounded bg-white border border-stone-200">
                    Plasticity: <%= obs.plasticity.humanize %>
                  </span>
                <% end %>
                <% if obs.fired_color.present? || obs.raw_color.present? %>
                  <span class="px-1.5 py-0.5 rounded bg-white border border-stone-200">
                    Color: <%= obs.fired_color.presence || obs.raw_color %>
                  </span>
                <% end %>
                <% if obs.fired_cone.present? %>
                  <span class="px-1.5 py-0.5 rounded bg-white border border-stone-200 font-mono">
                    Cone <%= obs.fired_cone %>
                  </span>
                <% end %>
                <% if obs.water_of_plasticity.present? %>
                  <span class="px-1.5 py-0.5 rounded bg-white border border-stone-200 font-mono">
                    WoP <%= format("%.1f%%", obs.water_of_plasticity.to_f) %>
                  </span>
                <% end %>
                <% if obs.drying_shrinkage_percent.present? %>
                  <span class="px-1.5 py-0.5 rounded bg-white border border-stone-200 font-mono">
                    Dry <%= format("%.1f%%", obs.drying_shrinkage_percent.to_f) %>
                  </span>
                <% end %>
                <% if obs.firing_shrinkage_percent.present? %>
                  <span class="px-1.5 py-0.5 rounded bg-white border border-stone-200 font-mono">
                    Fire <%= format("%.1f%%", obs.firing_shrinkage_percent.to_f) %>
                  </span>
                <% end %>
                <% if obs.boiling_water_absorption_percent.present? %>
                  <span class="px-1.5 py-0.5 rounded bg-white border border-stone-200 font-mono">
                    Abs <%= format("%.1f%%", obs.boiling_water_absorption_percent.to_f) %>
                  </span>
                <% end %>
                <% if obs.shrinkage_percent.present? %>
                  <span class="px-1.5 py-0.5 rounded bg-white border border-stone-200 font-mono">
                    <%= format("%.1f%%", obs.shrinkage_percent.to_f) %> shrink
                  </span>
                <% end %>
              </div>
              <span class="font-mono text-[10px] text-stone-400">
                #<%= obs.id %>
              </span>
            </div>

            <% if fit_badges.any? %>
              <div class="flex flex-wrap items-center gap-1.5">
                <% fit_badges.each do |badge| %>
                  <span
                    class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border <%= badge[:classes] %>"
                    title="<%= badge[:detail] %>"
                  >
                    <%= badge[:label] %>
                  </span>
                <% end %>
              </div>
            <% end %>

            <% raw_thumb_url = has_raw_photo ? stripped_photo_url(obs.raw_tile_photo, resize_to_limit: [ 240, 240 ]) : nil %>
            <% fired_thumb_url = has_fired_photo ? stripped_photo_url(obs.fired_tile_photo, resize_to_limit: [ 240, 240 ]) : nil %>
            <% if raw_thumb_url || fired_thumb_url %>
              <div class="flex flex-wrap items-center gap-2.5 pt-1" data-history-tile-photos="<%= obs.id %>">
                <% if (thumb_url = raw_thumb_url) %>
                  <% full_url = stripped_photo_url(obs.raw_tile_photo, resize_to_limit: [ 1600, 1600 ]) || thumb_url %>
                  <%= link_to full_url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-1.5 rounded-lg bg-white border border-[#D6C7B2] p-1 hover:border-[#B84A27] transition-colors" do %>
                    <%= image_tag thumb_url,
                      alt: "Raw tile photo for observation ##{obs.id}",
                      class: "w-11 h-11 rounded object-cover" %>
                    <span class="pr-1.5 text-[10px] font-semibold uppercase tracking-wider text-stone-600">Raw</span>
                  <% end %>
                <% end %>
                <% if (thumb_url = fired_thumb_url) %>
                  <% full_url = stripped_photo_url(obs.fired_tile_photo, resize_to_limit: [ 1600, 1600 ]) || thumb_url %>
                  <%= link_to full_url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-1.5 rounded-lg bg-white border border-[#D6C7B2] p-1 hover:border-[#1E4E79] transition-colors" do %>
                    <%= image_tag thumb_url,
                      alt: "Fired tile photo for observation ##{obs.id}",
                      class: "w-11 h-11 rounded object-cover" %>
                    <span class="pr-1.5 text-[10px] font-semibold uppercase tracking-wider text-[#1E4E79]">Fired</span>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
