<%
  occurrences = Array(local_assigns[:mineral_occurrences])
  pin_lat = local_assigns[:lat]
  pin_lng = local_assigns[:lng]
  refresh_status = local_assigns[:refresh_status]
  refresh_error = local_assigns[:refresh_error]
  has_coords = pin_lat.present? && pin_lng.present?
  hazard_terms = %w[pyrolusite barite witherite fluorite lepidolite pyrite chalcopyrite chromite monazite]

  compute_distance_km = lambda do |occ|
    if occ.has_attribute?(:distance_meters) && occ.read_attribute(:distance_meters).present?
      (occ.read_attribute(:distance_meters).to_f / 1000.0).round(1)
    elsif has_coords && occ.latitude.present? && occ.longitude.present?
      rad = Math::PI / 180.0
      dlat = (occ.latitude - pin_lat.to_f) * rad
      dlng = (occ.longitude - pin_lng.to_f) * rad
      a = (Math.sin(dlat / 2.0)**2) +
        Math.cos(pin_lat.to_f * rad) * Math.cos(occ.latitude * rad) * (Math.sin(dlng / 2.0)**2)
      (6371.0 * 2.0 * Math.atan2(Math.sqrt(a), Math.sqrt(1.0 - a))).round(1)
    end
  end

  source_badge = lambda do |src|
    case src.to_s
    when "usgs_mrds"
      [ "USGS MRDS", "bg-[#1E4E79]/10 text-[#1E4E79] border-[#1E4E79]/25" ]
    when "mindat"
      [ "Mindat.org", "bg-[#B84A27]/12 text-[#963B1D] border-[#B84A27]/25" ]
    when "pnw_curated_atlas"
      [ "PNW Atlas", "bg-amber-900/10 text-amber-950 border-amber-800/20" ]
    else
      [ src.to_s.tr("_", " ").titleize, "bg-stone-100 text-stone-700 border-stone-200" ]
    end
  end
%>

<div id="mineral_occurrences_card">
  <div class="rounded-xl border border-[#D6C7B2] bg-[#FAF7F2] p-4 space-y-3" data-mineral-occurrences-card>
    <div class="flex flex-wrap items-start justify-between gap-2.5">
      <div class="space-y-0.5 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-amber-600/15 text-amber-950 border border-amber-700/25">
            Hard-Rock Mineral Atlas
          </span>
          <h3 class="text-sm font-bold text-stone-900 leading-snug">
            Nearby Ceramic Deposits
            <span class="font-mono text-xs font-semibold text-stone-600">(<%= occurrences.size %>)</span>
          </h3>
        </div>
        <p class="text-[11px] text-stone-600">
          Hard-rock quarries, pegmatites &amp; industrial glaze mineral prospects (USGS MRDS &amp; Mindat.org)
        </p>
      </div>

      <% if has_coords %>
        <%= form_with url: refresh_mineral_occurrences_path, method: :post, class: "shrink-0" do |f| %>
          <%= hidden_field_tag :lat, pin_lat %>
          <%= hidden_field_tag :lng, pin_lng %>
          <%= hidden_field_tag :radius_km, 50 %>
          <button
            type="submit"
            data-mineral-refresh-button
            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-[#1E4E79] hover:bg-[#163B5C] text-[#FAF7F2] text-[11px] font-semibold shadow-sm transition-colors cursor-pointer"
            title="Query live USGS MRDS &amp; Mindat.org mineral occurrences around this pin"
          >
            <span aria-hidden="true">&#8635;</span>
            <span>Refresh Live (MRDS / Mindat)</span>
          </button>
        <% end %>
      <% end %>
    </div>

    <% if refresh_status.present? %>
      <div class="rounded-lg bg-emerald-50 border border-emerald-200 px-3 py-1.5 text-xs text-emerald-950" data-mineral-refresh-status>
        <%= refresh_status %>
      </div>
    <% end %>

    <% if refresh_error.present? %>
      <div class="rounded-lg bg-red-50 border border-red-200 px-3 py-1.5 text-xs text-red-900" data-mineral-refresh-error>
        <%= refresh_error %>
      </div>
    <% end %>

    <% if occurrences.any? %>
      <div class="divide-y divide-[#E8DFD0] rounded-lg border border-[#E8DFD0] bg-white overflow-hidden">
        <% occurrences.each do |occ| %>
          <% dist_km = compute_distance_km.call(occ) %>
          <% badge_label, badge_classes = source_badge.call(occ.source) %>
          <% highlights = occ.ceramic_highlights %>
          <% commodities = Array(occ.commodities) %>
          <% minerals = Array(occ.minerals) %>
          <% ceramic_role = occ.raw_metadata.is_a?(Hash) ? occ.raw_metadata["ceramic_role"] : nil %>

          <div class="px-3.5 py-2.5 space-y-1.5 hover:bg-[#FAF7F2]/60 transition-colors" data-mineral-occurrence-id="<%= occ.id %>">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0 space-y-0.5">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-xs font-bold text-stone-900 leading-snug"><%= occ.name %></span>
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold border <%= badge_classes %>">
                    <%= badge_label %>
                  </span>
                </div>
                <% if occ.deposit_type.present? %>
                  <div class="text-[11px] text-stone-500">
                    <span class="font-medium text-stone-600"><%= occ.deposit_type %></span>
                    <% if occ.raw_metadata.is_a?(Hash) && occ.raw_metadata["region"].present? %>
                      · <%= occ.raw_metadata["region"] %>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <% if dist_km.present? %>
                <span class="shrink-0 font-mono text-[11px] font-semibold tabular-nums px-2 py-0.5 rounded-md bg-[#FAF7F2] border border-[#E8DFD0] text-stone-700">
                  <%= number_with_precision(dist_km, precision: 1, strip_insignificant_zeros: true) %> km
                </span>
              <% end %>
            </div>

            <% if ceramic_role.present? %>
              <p class="text-[11px] text-stone-600 leading-relaxed">
                <%= ceramic_role %>
              </p>
            <% end %>

            <% if commodities.any? || minerals.any? %>
              <div class="flex flex-wrap items-center gap-1 pt-0.5">
                <% commodities.each do |commodity| %>
                  <% down = commodity.to_s.downcase %>
                  <% is_hazard = hazard_terms.any? { |h| down.include?(h) } %>
                  <% is_ceramic = highlights.include?(down) %>
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold border <%= is_hazard ? 'bg-rose-50 text-rose-900 border-rose-200' : (is_ceramic ? 'bg-amber-50 text-amber-950 border-amber-300/80' : 'bg-stone-100 text-stone-700 border-stone-200') %>">
                    <%= commodity %>
                  </span>
                <% end %>

                <% (minerals - commodities).first(6).each do |mineral| %>
                  <% down = mineral.to_s.downcase %>
                  <% is_hazard = hazard_terms.any? { |h| down.include?(h) } %>
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-medium border <%= is_hazard ? 'bg-rose-50 text-rose-900 border-rose-200' : 'bg-[#FAF7F2] text-stone-700 border-[#E8DFD0]' %>">
                    <%= mineral %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed border-[#E8DFD0] bg-white/70 px-3.5 py-2.5 flex items-center gap-2 text-xs text-stone-500">
        <span class="inline-block w-2 h-2 rounded-full bg-amber-400/80 shrink-0"></span>
        <span>
          <% if has_coords %>
            No cached hard-rock mineral deposits within range yet — click <strong>Refresh Live (MRDS / Mindat)</strong> to query USGS MRDS.
          <% else %>
            Drop a pin on the map to inspect nearby hard-rock feldspar, basalt, talc, kaolin, and glaze mineral deposits.
          <% end %>
        </span>
      </div>
    <% end %>
  </div>
</div>
