<%= turbo_frame_tag "geologic_unit_card",
  data: {
    map_picker_target: "geologicFrame",
    action: "turbo:frame-load->map-picker#handleGeologicUnitLoaded"
  } do %>
  <% boundary_json = geologic_unit_boundary_geojson(geologic_unit) %>
  <% unit_color = geologic_unit_swatch_color(geologic_unit) %>

  <div
    data-geologic-unit-meta
    data-geologic-unit-id="<%= geologic_unit&.id %>"
    data-boundary-geojson="<%= boundary_json.to_s %>"
    data-unit-color="<%= unit_color %>"
    data-unit-name="<%= geologic_unit&.name.to_s %>"
    class="rounded-xl border <%= geologic_unit.present? ? 'border-[#1E4E79]/30 bg-[#1E4E79]/[0.04]' : 'border-[#E8DFD0] bg-[#FAF7F2]' %> p-4 transition-colors"
  >
    <% if geologic_unit.present? %>
      <div class="flex items-start justify-between gap-3">
        <div class="space-y-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span
              class="inline-block w-3 h-3 rounded-full border border-stone-900/20 shrink-0"
              style="background-color: <%= unit_color %>;"
            ></span>
            <h3 class="text-sm font-bold text-stone-900 leading-snug">
              <%= geologic_unit.name.presence || "Unnamed Geologic Unit" %>
            </h3>
            <% if geologic_unit.age.present? %>
              <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-[#1E4E79]/10 text-[#1E4E79] border border-[#1E4E79]/20">
                <%= geologic_unit.age %>
              </span>
            <% end %>
          </div>

          <% if geologic_unit.strat_name.present? %>
            <p class="text-xs text-stone-600">
              <span class="font-medium text-stone-500">Stratigraphic Unit:</span>
              <%= geologic_unit.strat_name %>
            </p>
          <% end %>
        </div>

        <span class="shrink-0 font-mono text-[11px] px-2 py-0.5 rounded-md bg-white border border-stone-200 text-stone-600">
          Macrostrat #<%= geologic_unit.macrostrat_id %>
        </span>
      </div>

      <% terms = geologic_unit.lithology_terms %>
      <% if terms.any? %>
        <div class="mt-3 flex flex-wrap items-center gap-1.5">
          <span class="text-[10px] uppercase tracking-wider font-semibold text-stone-500 mr-1">Lithology:</span>
          <% terms.each do |term| %>
            <span class="px-2 py-0.5 rounded-md text-xs font-medium bg-white border border-[#D6C7B2] text-stone-800 capitalize">
              <%= term %>
            </span>
          <% end %>
        </div>
      <% end %>

      <% if lat.present? && lng.present? %>
        <div class="mt-2.5 pt-2 border-t border-[#1E4E79]/10 flex items-center justify-between text-[11px] text-stone-500">
          <span class="font-mono tabular-nums">Pin: <%= format("%.4f, %.4f", lat.to_f, lng.to_f) %></span>
          <% if defined?(nearby_assay_count) && nearby_assay_count.to_i > 0 %>
            <span><%= nearby_assay_count %> reference assays in region</span>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="flex items-start justify-between gap-3">
        <div class="space-y-1">
          <div class="text-xs font-semibold text-stone-700 flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-stone-400"></span>
            <% if defined?(lookup_performed) && lookup_performed %>
              No cached Macrostrat geologic polygon at this point
            <% else %>
              Click the map to inspect the Macrostrat geologic unit
            <% end %>
          </div>
          <p class="text-xs text-stone-500 leading-relaxed">
            <% if lat.present? && lng.present? %>
              Inspected <span class="font-mono tabular-nums text-stone-700"><%= format("%.4f, %.4f", lat.to_f, lng.to_f) %></span>.
              <% if defined?(nearby_assay_count) && nearby_assay_count.to_i > 0 %>
                Found <strong><%= nearby_assay_count %></strong> nearby reference assays within 50 km for spatial baseline inference.
              <% else %>
                Spatial radius and material category baselines will be used when saving.
              <% end %>
            <% else %>
              Selecting a point on the map queries Macrostrat for rock formation, geological age, and lithology tags.
            <% end %>
          </p>
        </div>
      </div>
    <% end %>

    <% lookup_soil = local_assigns[:soil_profile] %>
    <% if lookup_soil.present? %>
      <% best_hz = lookup_soil.clay_rich_horizon %>
      <% is_soilgrids = lookup_soil.source.to_s == "isric_soilgrids" %>
      <div class="mt-3 pt-2.5 border-t border-[#1E4E79]/15 flex flex-wrap items-center justify-between gap-2 text-xs" data-lookup-soil-summary>
        <div class="flex items-center gap-2 flex-wrap text-stone-800">
          <% if is_soilgrids %>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-[#1E4E79]/10 text-[#1E4E79] border border-[#1E4E79]/25">
              SoilGrids v2
            </span>
          <% else %>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-900/10 text-amber-950 border border-amber-800/20">
              USDA Soil
            </span>
          <% end %>
          <span class="font-semibold"><%= lookup_soil.summary_label %></span>
          <% if best_hz.present? && best_hz["plasticity_index"].present? %>
            <span class="font-mono text-[11px] text-stone-600">
              PI <%= number_with_precision(best_hz["plasticity_index"].to_f, precision: 1, strip_insignificant_zeros: true) %>
            </span>
          <% elsif lookup_soil.cec.present? %>
            <span class="font-mono text-[11px] text-stone-600">
              CEC <%= number_with_precision(lookup_soil.cec.to_f, precision: 1, strip_insignificant_zeros: true) %> cmol/kg
            </span>
          <% end %>
        </div>
        <% if lookup_soil.max_caco3_pct.to_f >= 2.0 %>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-950 border border-amber-300">
            CaCO₃ ≥ 2% (Fizz Risk)
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
