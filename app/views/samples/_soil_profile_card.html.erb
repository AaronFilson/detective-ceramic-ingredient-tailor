<div id="soil_profile_card" class="space-y-3">
  <%
    nearby_xrd = Array(local_assigns[:nearby_xrd_assays]).select do |assay|
      assay.respond_to?(:xrd_mineralogy) && assay.xrd_mineralogy.is_a?(Hash) && assay.xrd_mineralogy.any?
    end
  %>

  <% if soil_profile.present? %>
    <%
      is_soilgrids = soil_profile.source.to_s == "isric_soilgrids"
      best_horizon = soil_profile.clay_rich_horizon
      horizons = Array(soil_profile.horizons).select { |h| h.is_a?(Hash) }
      high_carbonate = soil_profile.max_caco3_pct.to_f >= 2.0 || horizons.any? { |h| h["caco3_pct"].to_f >= 2.0 }
      has_chemistry_badges = soil_profile.soil_ph.present? || soil_profile.cec.present? || soil_profile.organic_carbon.present?
      show_soilgrids_cols = is_soilgrids && horizons.none? { |h| h["plasticity_index"].present? || h["caco3_pct"].present? }

      cec_val = soil_profile.cec.present? ? soil_profile.cec.to_f : nil
      cec_hint =
        if cec_val.nil?
          nil
        elsif cec_val < 15.0
          { label: "Kaolinitic", classes: "bg-sky-50 text-sky-900 border-sky-200" }
        elsif cec_val <= 40.0
          { label: "Illitic", classes: "bg-stone-100 text-stone-800 border-stone-300" }
        else
          { label: "Smectitic · High Shrinkage", classes: "bg-amber-100 text-amber-950 border-amber-300" }
        end

      ph_val = soil_profile.soil_ph.present? ? soil_profile.soil_ph.to_f : nil
      ph_hint =
        if ph_val.nil?
          nil
        elsif ph_val < 5.5
          "Acidic"
        elsif ph_val > 7.5
          "Alkaline"
        else
          "Neutral"
        end
    %>

    <div class="rounded-xl border border-[#D6C7B2] bg-[#FAF7F2] p-4 space-y-3" data-soil-profile-card data-soil-source="<%= soil_profile.source %>">
      <div class="flex items-start justify-between gap-3">
        <div class="space-y-0.5 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <% if is_soilgrids %>
              <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-[#1E4E79]/10 text-[#1E4E79] border border-[#1E4E79]/25">
                ISRIC SoilGrids v2 (Global 250m)
              </span>
            <% else %>
              <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-amber-900/10 text-amber-950 border border-amber-800/20">
                USDA NRCS SSURGO
              </span>
            <% end %>
            <h3 class="text-sm font-bold text-stone-900 leading-snug">
              <%= soil_profile.component_name.presence || soil_profile.map_unit_name.presence || "Soil Map Unit" %>
              <% if soil_profile.component_percent.present? %>
                <span class="font-mono text-xs font-semibold text-stone-600">
                  (<%= number_with_precision(soil_profile.component_percent, precision: 0) %>%)
                </span>
              <% end %>
            </h3>
          </div>

          <% if soil_profile.map_unit_name.present? && soil_profile.map_unit_name != soil_profile.component_name %>
            <p class="text-xs text-stone-600 truncate">
              <span class="font-medium text-stone-500"><%= is_soilgrids ? "Dataset:" : "Map Unit:" %></span>
              <%= soil_profile.map_unit_name %>
            </p>
          <% end %>
        </div>

        <span class="shrink-0 font-mono text-[11px] px-2 py-0.5 rounded-md bg-white border border-stone-200 text-stone-600">
          <%= is_soilgrids ? soil_profile.mukey : "MUKEY ##{soil_profile.mukey}" %>
        </span>
      </div>

      <%# Soil Chemistry Badges: pH, CEC (clay mineralogy proxy), Organic Carbon %>
      <% if has_chemistry_badges %>
        <div class="flex flex-wrap items-center gap-1.5 text-[11px]" data-soil-chemistry-badges>
          <% if ph_val.present? %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white border border-[#D6C7B2] text-stone-800">
              <span class="font-semibold text-stone-500">pH</span>
              <span class="font-mono font-bold tabular-nums"><%= number_with_precision(ph_val, precision: 1) %></span>
              <span class="text-stone-500">· <%= ph_hint %></span>
            </span>
          <% end %>

          <% if cec_val.present? %>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md border <%= cec_hint[:classes] %>">
              <span class="font-semibold">CEC</span>
              <span class="font-mono font-bold tabular-nums"><%= number_with_precision(cec_val, precision: 1, strip_insignificant_zeros: true) %> cmol/kg</span>
              <span class="font-medium">· <%= cec_hint[:label] %></span>
            </span>
          <% end %>

          <% if soil_profile.organic_carbon.present? %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white border border-[#D6C7B2] text-stone-800">
              <span class="font-semibold text-stone-500">Organic C</span>
              <span class="font-mono font-bold tabular-nums"><%= number_with_precision(soil_profile.organic_carbon.to_f, precision: 1, strip_insignificant_zeros: true) %> g/kg</span>
            </span>
          <% end %>
        </div>
      <% end %>

      <%# Dominant Clay-Rich Digging Depth Banner %>
      <% if best_horizon.present? %>
        <% depth_range = [ best_horizon["top_cm"], best_horizon["bottom_cm"] ].compact.join("–") %>
        <div class="rounded-lg bg-[#B84A27]/10 border border-[#B84A27]/25 px-3 py-2 flex flex-wrap items-center justify-between gap-2 text-xs">
          <div class="text-stone-900">
            <span class="font-bold text-[#963B1D]">Best clay horizon:</span>
            <span class="font-mono font-bold"><%= best_horizon["hzname"].presence || "Subsoil" %></span>
            <% if depth_range.present? %>
              <span class="font-mono text-stone-700">(<%= depth_range %> cm)</span>
            <% end %>
            —
            <strong><%= number_with_precision(best_horizon["clay_pct"].to_f, precision: 1, strip_insignificant_zeros: true) %>% clay</strong><% if best_horizon["plasticity_index"].present? %>,
              <span class="font-mono">PI <%= number_with_precision(best_horizon["plasticity_index"].to_f, precision: 1, strip_insignificant_zeros: true) %></span><% elsif best_horizon["cec_cmol_kg"].present? %>,
              <span class="font-mono">CEC <%= number_with_precision(best_horizon["cec_cmol_kg"].to_f, precision: 1, strip_insignificant_zeros: true) %> cmol/kg</span><% end %>
          </div>

          <% if high_carbonate %>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-950 border border-amber-300">
              CaCO₃ ≥ 2% · Expect Vinegar Fizz
            </span>
          <% end %>
        </div>
      <% elsif high_carbonate %>
        <div class="rounded-lg bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-950 font-medium">
          Elevated soil carbonate detected (max CaCO₃ <%= number_with_precision(soil_profile.max_caco3_pct.to_f, precision: 1, strip_insignificant_zeros: true) %>%) — test raw clay with vinegar for fizz.
        </div>
      <% end %>

      <%# Per-Horizon Depth Bar Table %>
      <% if horizons.any? %>
        <div class="overflow-x-auto rounded-lg border border-[#E8DFD0] bg-white">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-[#FAF7F2] border-b border-[#E8DFD0] text-[10px] uppercase tracking-wider text-stone-500">
                <th class="py-2 pl-3 pr-2 font-semibold"><%= show_soilgrids_cols ? "Layer" : "Horizon" %></th>
                <th class="py-2 px-2 font-semibold">Depth (cm)</th>
                <th class="py-2 px-2 font-semibold w-36 sm:w-44">Clay %</th>
                <% if show_soilgrids_cols %>
                  <th class="py-2 px-2 font-semibold text-right">pH</th>
                  <th class="py-2 pl-2 pr-3 font-semibold text-right">CEC (cmol/kg)</th>
                <% else %>
                  <th class="py-2 px-2 font-semibold text-right">PI</th>
                  <th class="py-2 pl-2 pr-3 font-semibold text-right">CaCO₃ %</th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
              <% horizons.each do |hz| %>
                <% is_best = best_horizon.present? && hz == best_horizon %>
                <% clay_val = hz["clay_pct"].present? ? hz["clay_pct"].to_f.clamp(0.0, 100.0) : nil %>
                <% depth_str = [ hz["top_cm"], hz["bottom_cm"] ].compact.join("–") %>
                <tr class="<%= is_best ? 'bg-[#B84A27]/[0.06]' : 'hover:bg-[#FAF7F2]/70' %>">
                  <td class="py-1.5 pl-3 pr-2 font-mono font-bold text-stone-900 whitespace-nowrap">
                    <span><%= hz["hzname"].presence || "—" %></span>
                    <% if is_best %>
                      <span class="ml-1 px-1.5 py-0.5 rounded text-[9px] font-sans font-bold uppercase bg-[#B84A27] text-white">
                        Dig
                      </span>
                    <% end %>
                  </td>
                  <td class="py-1.5 px-2 font-mono text-stone-600 tabular-nums whitespace-nowrap">
                    <%= depth_str.presence || "—" %>
                  </td>
                  <td class="py-1.5 px-2">
                    <% if clay_val.present? %>
                      <div class="flex items-center gap-2">
                        <div class="flex-1 h-2 rounded-full bg-stone-100 overflow-hidden" aria-hidden="true">
                          <div
                            class="h-full rounded-full <%= is_best ? 'bg-[#B84A27]' : 'bg-[#1E4E79]/65' %>"
                            style="width: <%= clay_val.round(1) %>%"
                          ></div>
                        </div>
                        <span class="font-mono text-[11px] font-semibold text-stone-800 tabular-nums w-9 text-right">
                          <%= number_with_precision(clay_val, precision: 0) %>%
                        </span>
                      </div>
                    <% else %>
                      <span class="text-stone-400">—</span>
                    <% end %>
                  </td>
                  <% if show_soilgrids_cols %>
                    <td class="py-1.5 px-2 font-mono text-right tabular-nums text-stone-700">
                      <%= hz["ph"].present? ? number_with_precision(hz["ph"].to_f, precision: 1) : "—" %>
                    </td>
                    <td class="py-1.5 pl-2 pr-3 font-mono text-right tabular-nums text-stone-700">
                      <%= hz["cec_cmol_kg"].present? ? number_with_precision(hz["cec_cmol_kg"].to_f, precision: 1, strip_insignificant_zeros: true) : "—" %>
                    </td>
                  <% else %>
                    <% caco3_val = hz["caco3_pct"].present? ? hz["caco3_pct"].to_f : nil %>
                    <% fizz_risk = caco3_val.present? && caco3_val >= 2.0 %>
                    <td class="py-1.5 px-2 font-mono text-right tabular-nums text-stone-700">
                      <%= hz["plasticity_index"].present? ? number_with_precision(hz["plasticity_index"].to_f, precision: 1, strip_insignificant_zeros: true) : "—" %>
                    </td>
                    <td class="py-1.5 pl-2 pr-3 font-mono text-right tabular-nums whitespace-nowrap">
                      <% if caco3_val.present? %>
                        <span><%= number_with_precision(caco3_val, precision: 1, strip_insignificant_zeros: true) %>%</span>
                        <% if fizz_risk %>
                          <span class="ml-1 inline-block px-1.5 py-0.5 rounded font-sans text-[9px] font-bold bg-amber-100 text-amber-950 border border-amber-300">
                            Fizz
                          </span>
                        <% end %>
                      <% else %>
                        <span class="text-stone-400">—</span>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-[#E8DFD0] bg-[#FAF7F2]/70 px-3.5 py-2.5 flex items-center gap-2 text-xs text-stone-500">
      <span class="inline-block w-2 h-2 rounded-full bg-stone-300 shrink-0"></span>
      <span>USDA SSURGO soil horizon profile populates automatically for US coordinates — with ISRIC SoilGrids v2 global fallback outside the US</span>
    </div>
  <% end %>

  <%# Regional Soil XRD Mineralogy Breakdown (USGS DS-801) %>
  <% if nearby_xrd.any? %>
    <%
      assay_count = nearby_xrd.size.to_f
      mineral_defs = [
        { key: "quartz", label: "Quartz", color: "#C8B69E", value: nearby_xrd.sum { |a| a.xrd_mineralogy["quartz"].to_f } / assay_count },
        { key: "kaolinite", label: "Kaolinite", color: "#1E4E79", value: nearby_xrd.sum { |a| a.xrd_mineralogy["kaolinite"].to_f } / assay_count },
        { key: "illite", label: "Illite", color: "#B84A27", value: nearby_xrd.sum { |a| a.xrd_mineralogy["illite"].to_f } / assay_count },
        { key: "smectite", label: "Smectite", color: "#D97706", value: nearby_xrd.sum { |a| a.xrd_mineralogy["smectite"].to_f } / assay_count },
        { key: "feldspar", label: "Feldspar", color: "#64748B", value: nearby_xrd.sum { |a| a.xrd_mineralogy["k_feldspar"].to_f + a.xrd_mineralogy["plagioclase"].to_f } / assay_count },
        { key: "calcite", label: "Calcite", color: "#059669", value: nearby_xrd.sum { |a| a.xrd_mineralogy["calcite"].to_f + a.xrd_mineralogy["dolomite"].to_f } / assay_count }
      ]
      visible_minerals = mineral_defs.select { |m| m[:value] >= 0.5 }
      bar_total = visible_minerals.sum { |m| m[:value] }
    %>

    <% if visible_minerals.any? && bar_total.positive? %>
      <div class="rounded-xl border border-[#D6C7B2] bg-[#FAF7F2] px-4 py-3 space-y-2" data-regional-xrd-card>
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-[#1E4E79]/10 text-[#1E4E79] border border-[#1E4E79]/20">
              XRD
            </span>
            <h4 class="text-xs font-bold text-stone-900">
              Regional Soil XRD Mineralogy (USGS DS-801)
            </h4>
          </div>
          <span class="font-mono text-[11px] text-stone-500">
            <%= pluralize(nearby_xrd.size, "site") %> avg
          </span>
        </div>

        <div class="h-2.5 w-full rounded-full overflow-hidden flex bg-stone-200" role="img" aria-label="Regional Soil XRD Mineralogy breakdown">
          <% visible_minerals.each do |mineral| %>
            <% width_pct = (mineral[:value] / bar_total * 100.0).round(1) %>
            <div
              style="width: <%= width_pct %>%; background-color: <%= mineral[:color] %>;"
              title="<%= mineral[:label] %>: <%= number_with_precision(mineral[:value], precision: 1, strip_insignificant_zeros: true) %>%"
            ></div>
          <% end %>
        </div>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-stone-700">
          <% visible_minerals.each do |mineral| %>
            <span class="inline-flex items-center gap-1.5" data-xrd-mineral="<%= mineral[:key] %>">
              <span class="inline-block w-2 h-2 rounded-full shrink-0" style="background-color: <%= mineral[:color] %>;"></span>
              <span class="font-medium"><%= mineral[:label] %></span>
              <span class="font-mono font-semibold tabular-nums text-stone-900">
                <%= number_with_precision(mineral[:value], precision: 1, strip_insignificant_zeros: true) %>%
              </span>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
