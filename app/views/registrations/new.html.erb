<% content_for :title, "Create Studio Account — DCI Tailor" %>

<div class="min-h-screen flex flex-col bg-[#F5F0E6]">
  <header class="shrink-0 bg-[#1F1B18] text-[#FAF7F2] border-b border-stone-800 px-4 sm:px-5 py-2.5 flex items-center justify-between gap-3">
    <%= link_to root_path, class: "flex items-center gap-2.5 group focus:outline-none" do %>
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#B84A27] text-[#FAF7F2] shadow-inner font-mono text-xs font-bold tracking-tight group-hover:bg-[#C85A32] transition-colors">
        SiO₂
      </span>
      <div class="leading-tight">
        <div class="font-semibold tracking-tight text-sm sm:text-base text-[#FAF7F2]">DCI Tailor</div>
        <div class="text-[11px] text-stone-400">Detective Ceramic Ingredient Tailor · Create Studio Account</div>
      </div>
    <% end %>

    <%= link_to "← Continue in Guest Sandbox",
      root_path,
      class: "px-3 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-200 border border-stone-700 text-xs font-medium transition-colors" %>
  </header>

  <main class="flex-1 flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-md rounded-2xl bg-[#FCFBF8] border border-[#D6C7B2] shadow-lg overflow-hidden">
      <div class="px-6 py-4 bg-[#FAF7F2] border-b border-[#E8DFD0]">
        <span class="font-mono text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[#B84A27]/12 text-[#963B1D] border border-[#B84A27]/20">
          Free Ceramic Studio Account
        </span>
        <h1 class="mt-1.5 text-lg font-bold text-stone-900 tracking-tight">Save your studio permanently</h1>
        <p class="text-xs text-stone-600 mt-0.5">
          Keep private dig-site samples, test-tile logs, glaze blends, and Glazecalc API tokens synced to your account.
        </p>
      </div>

      <div class="p-6 space-y-4">
        <% if flash[:alert].present? %>
          <div class="rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs text-red-900" role="alert">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <% if @user&.errors&.any? %>
          <div class="rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs text-red-900" role="alert">
            <div class="font-semibold mb-1">Please fix the following to create your account:</div>
            <ul class="list-disc pl-4 space-y-0.5">
              <% @user.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if guest_sample_count.positive? %>
          <div class="rounded-xl bg-amber-50/90 border border-amber-200 px-3.5 py-2.5 text-xs text-amber-950" data-guest-claim-banner>
            <strong><%= pluralize(guest_sample_count, "guest sample") %> ready to claim:</strong>
            Your current guest samples and studio setup will automatically transfer into your account.
          </div>
        <% else %>
          <div class="rounded-xl bg-[#FAF7F2] border border-[#E8DFD0] px-3.5 py-2 text-[11px] text-stone-600">
            Your current guest samples and studio setup will automatically transfer into your account.
          </div>
        <% end %>

        <%= form_with model: @user, url: registration_path, method: :post, class: "space-y-3.5" do |f| %>
          <div>
            <%= f.label :name, "Studio or Potter Name", class: "block text-xs font-semibold text-stone-700 mb-1" %>
            <%= f.text_field :name,
              autofocus: true,
              autocomplete: "name",
              placeholder: "e.g., Puget Sound Clayworks",
              class: "w-full rounded-xl border border-[#D6C7B2] bg-white px-3.5 py-2 text-sm text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-[#B84A27]/40 focus:border-[#B84A27]" %>
          </div>

          <div>
            <%= f.label :email, "Email Address", class: "block text-xs font-semibold text-stone-700 mb-1" %>
            <%= f.email_field :email,
              required: true,
              autocomplete: "email",
              placeholder: "potter@studio.example",
              class: "w-full rounded-xl border border-[#D6C7B2] bg-white px-3.5 py-2 text-sm text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-[#B84A27]/40 focus:border-[#B84A27]" %>
          </div>

          <div>
            <%= f.label :password, "Password (min. 8 characters)", class: "block text-xs font-semibold text-stone-700 mb-1" %>
            <%= f.password_field :password,
              required: true,
              minlength: 8,
              autocomplete: "new-password",
              placeholder: "At least 8 characters",
              class: "w-full rounded-xl border border-[#D6C7B2] bg-white px-3.5 py-2 text-sm text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-[#B84A27]/40 focus:border-[#B84A27]" %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirm Password", class: "block text-xs font-semibold text-stone-700 mb-1" %>
            <%= f.password_field :password_confirmation,
              required: true,
              minlength: 8,
              autocomplete: "new-password",
              placeholder: "Repeat password",
              class: "w-full rounded-xl border border-[#D6C7B2] bg-white px-3.5 py-2 text-sm text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-[#B84A27]/40 focus:border-[#B84A27]" %>
          </div>

          <%= f.submit "Create Studio Account",
            class: "w-full py-2.5 px-4 rounded-xl bg-[#B84A27] hover:bg-[#963B1D] text-[#FAF7F2] text-sm font-semibold shadow-sm transition-colors cursor-pointer" %>
        <% end %>

        <div class="pt-3 border-t border-[#E8DFD0] text-center text-xs text-stone-600">
          Already have a studio account?
          <%= link_to "Sign In", new_session_path, class: "font-semibold text-[#1E4E79] hover:underline" %>
        </div>
      </div>
    </div>
  </main>
</div>
