<% content_for :title, "Studio Setup Wizard — DCI Tailor" %>

<div class="flex flex-col flex-1 min-h-0 lg:h-screen bg-[#F5F0E6]">
  <header class="shrink-0 bg-[#1F1B18] text-[#FAF7F2] border-b border-stone-800 px-4 sm:px-5 py-2.5 flex items-center justify-between gap-3">
    <%= link_to root_path(skip_wizard: 1), class: "flex items-center gap-2.5 group focus:outline-none" do %>
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#B84A27] text-[#FAF7F2] shadow-inner font-mono text-xs font-bold tracking-tight group-hover:bg-[#C85A32] transition-colors">
        SiO₂
      </span>
      <div class="leading-tight">
        <div class="font-semibold tracking-tight text-sm sm:text-base text-[#FAF7F2]">
          DCI Tailor
        </div>
        <div class="text-[11px] text-stone-400">
          Detective Ceramic Ingredient Tailor · Studio Setup Wizard
        </div>
      </div>
    <% end %>

    <div class="flex items-center gap-2.5 flex-wrap">
      <% if @studio_setting.onboarding_completed? || @studio_setting.onboarding_skipped_at.present? %>
        <%= button_to "Reset First-Time Prompt",
          reset_setup_path,
          method: :post,
          class: "px-3 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-300 border border-stone-700 text-xs font-medium transition-colors cursor-pointer" %>
      <% end %>

      <%= render "shared/auth_header_controls" %>
    </div>
  </header>

  <% if flash[:notice].present? || flash[:alert].present? %>
    <div class="shrink-0 px-4 py-2 text-xs sm:text-sm border-b <%= flash[:alert].present? ? 'bg-red-50 text-red-900 border-red-200' : 'bg-emerald-50 text-emerald-950 border-emerald-200' %>">
      <%= flash[:alert] || flash[:notice] %>
    </div>
  <% end %>

  <main class="flex-1 min-h-0 overflow-y-auto studio-scroll py-6 px-4 sm:px-6 flex items-start justify-center">
    <%= render "setup_wizard/wizard_content",
      studio_setting: @studio_setting,
      initial_step: @initial_step,
      modal: false %>
  </main>
</div>
