<% content_for :title, "Local Glaze Blend Builder — DCI Tailor" %>

<div class="flex flex-col flex-1 min-h-0 lg:h-screen bg-[#F5F0E6]">
  <%# Top Studio Header Bar %>
  <header class="shrink-0 bg-[#1F1B18] text-[#FAF7F2] border-b border-stone-800 px-4 sm:px-5 py-2.5 flex flex-wrap items-center justify-between gap-3 z-20">
    <div class="flex items-center gap-3 min-w-0">
      <%= link_to root_path, class: "flex items-center gap-2.5 group focus:outline-none" do %>
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#B84A27] text-[#FAF7F2] shadow-inner font-mono text-xs font-bold tracking-tight group-hover:bg-[#C85A32] transition-colors">
          SiO₂
        </span>
        <div class="leading-tight">
          <div class="font-semibold tracking-tight text-sm sm:text-base text-[#FAF7F2]">
            DCI Tailor
          </div>
          <div class="text-[11px] text-stone-400 hidden sm:block">
            Local Line-Blend &amp; Triaxial Glaze Recipe Builder
          </div>
        </div>
      <% end %>
    </div>

    <div class="flex items-center gap-2.5 flex-wrap">
      <%= link_to root_path,
        class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-[#FAF7F2] border border-stone-700 text-xs sm:text-sm font-medium transition-colors" do %>
        <span>← Sample Workbench</span>
      <% end %>

      <%= link_to setup_path,
        class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-200 border border-stone-700 text-xs sm:text-sm font-medium transition-colors" do %>
        <span>Setup Wizard</span>
      <% end %>

      <%= link_to new_sample_path,
        class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#B84A27] hover:bg-[#C85A32] text-[#FAF7F2] text-xs sm:text-sm font-semibold shadow-sm transition-colors" do %>
        <span aria-hidden="true" class="text-base leading-none">+</span>
        <span>New Sample</span>
      <% end %>
    </div>
  </header>

  <%# Main Scrollable Blend Studio Layout %>
  <main class="flex-1 min-h-0 overflow-y-auto studio-scroll">
    <div class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8 space-y-6 pb-14">
      <%# Hero Banner %>
      <section class="rounded-2xl bg-[#FCFBF8] border border-[#D6C7B2] shadow-sm px-5 py-4 flex flex-wrap items-center justify-between gap-4">
        <div class="space-y-1 max-w-2xl">
          <div class="flex items-center gap-2">
            <span class="font-mono text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[#1E4E79]/12 text-[#1E4E79] border border-[#1E4E79]/20">
              UMF Optimizer
            </span>
            <span class="font-mono text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[#B84A27]/12 text-[#963B1D] border border-[#B84A27]/20">
              Line &amp; Triaxial Blends
            </span>
          </div>
          <h1 class="text-lg sm:text-xl font-bold text-stone-900 tracking-tight">
            Local Material Glaze Recipe Builder
          </h1>
          <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
            Combine 2 assayed local materials (wild clay, wood ash, crushed rock) for an 11-step line blend or 3 materials for a 5% triaxial simplex grid. DCI Tailor scores every blend against Cone 6 &amp; Cone 10 Gloss/Matte Seger UMF target bands and exports complete Materials + Recipe bundles.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-2 text-center font-mono text-xs shrink-0">
          <div class="rounded-xl bg-[#FAF7F2] border border-[#E8DFD0] px-3.5 py-2">
            <div class="text-lg font-bold text-stone-900 tabular-nums"><%= @available_samples.size %></div>
            <div class="text-[10px] uppercase tracking-wider text-stone-500">Assayed Materials</div>
          </div>
          <div class="rounded-xl bg-[#FAF7F2] border border-[#E8DFD0] px-3.5 py-2">
            <div class="text-lg font-bold text-[#1E4E79] tabular-nums">11 / 231</div>
            <div class="text-[10px] uppercase tracking-wider text-stone-500">Line / Triaxial Pts</div>
          </div>
        </div>
      </section>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <%# LEFT COLUMN: Material & Firing Target Selector Form %>
        <section class="lg:col-span-4 rounded-2xl bg-[#FCFBF8] border border-[#D6C7B2] shadow-sm overflow-hidden">
          <div class="px-5 py-3.5 bg-[#FAF7F2] border-b border-[#E8DFD0] flex items-center justify-between gap-2">
            <h2 class="text-sm font-bold text-stone-900 tracking-tight">
              1. Pick 2 or 3 Local Materials
            </h2>
            <span class="font-mono text-[11px] text-stone-500">Dry Wt %</span>
          </div>

          <div class="p-5">
            <% if @available_samples.any? %>
              <%= form_with url: blends_path, method: :post, data: { turbo_frame: "blend_results" }, class: "space-y-5" do |form| %>
                <%# Sample Checkboxes %>
                <fieldset class="space-y-2">
                  <legend class="text-[11px] font-semibold uppercase tracking-wider text-stone-600 mb-2">
                    Saved Samples With Chemical Assays
                  </legend>
                  <div class="space-y-2 max-h-[340px] overflow-y-auto pr-1 studio-scroll">
                    <% @available_samples.each do |sample| %>
                      <% assay = sample.latest_assay_result %>
                      <% oxides = assay&.oxides || {} %>
                      <% checked = @selected_sample_ids.include?(sample.id) %>
                      <label class="flex items-start gap-2.5 rounded-xl border p-3 cursor-pointer transition-colors <%= checked ? 'border-[#1E4E79] bg-[#1E4E79]/5' : 'border-[#E8DFD0] bg-white hover:border-[#D6C7B2]' %>">
                        <input
                          type="checkbox"
                          name="sample_ids[]"
                          value="<%= sample.id %>"
                          <%= "checked" if checked %>
                          class="mt-0.5 rounded border-stone-400 text-[#1E4E79] focus:ring-[#1E4E79]"
                        >
                        <div class="min-w-0 flex-1 space-y-1">
                          <div class="flex items-center justify-between gap-2">
                            <span class="text-xs font-bold text-stone-900 truncate"><%= sample.title %></span>
                            <span class="shrink-0 text-[10px] font-medium px-1.5 py-0.5 rounded bg-[#FAF7F2] text-stone-600 border border-[#E8DFD0]">
                              <%= material_category_label(sample.material_category) %>
                            </span>
                          </div>
                          <div class="font-mono text-[10px] text-stone-500 flex flex-wrap gap-x-2.5 gap-y-0.5 tabular-nums">
                            <span>SiO₂ <%= format("%.1f", oxides["SiO2"].to_f) %>%</span>
                            <span>Al₂O₃ <%= format("%.1f", oxides["Al2O3"].to_f) %>%</span>
                            <span>CaO <%= format("%.1f", oxides["CaO"].to_f) %>%</span>
                            <span>Fe₂O₃ <%= format("%.1f", oxides["Fe2O3"].to_f) %>%</span>
                          </div>
                        </div>
                      </label>
                    <% end %>
                  </div>
                  <p class="text-[11px] text-stone-500">
                    Check <strong>2 materials</strong> for a 10% Line Blend or <strong>3 materials</strong> for a 5% Triaxial Simplex.
                  </p>
                </fieldset>

                <%# Target Cone Selector %>
                <fieldset class="space-y-2">
                  <legend class="text-[11px] font-semibold uppercase tracking-wider text-stone-600">
                    2. Target Firing Cone
                  </legend>
                  <div class="grid grid-cols-2 gap-2">
                    <% [ [ "6", "Cone 6", "Mid-Fire · 1222 °C" ], [ "10", "Cone 10", "High-Fire · 1305 °C" ] ].each do |cone_val, title, subtitle| %>
                      <label class="relative flex flex-col rounded-xl border border-[#D6C7B2] bg-[#FAF7F2] px-3 py-2.5 cursor-pointer hover:border-[#1E4E79] has-[:checked]:border-[#1E4E79] has-[:checked]:bg-[#1E4E79]/10 transition-colors">
                        <input
                          type="radio"
                          name="target_cone"
                          value="<%= cone_val %>"
                          <%= "checked" if @target_cone == cone_val %>
                          class="sr-only"
                        >
                        <span class="text-xs font-bold text-stone-900"><%= title %></span>
                        <span class="text-[10px] font-mono text-stone-500"><%= subtitle %></span>
                      </label>
                    <% end %>
                  </div>
                </fieldset>

                <%# Target Surface Selector %>
                <fieldset class="space-y-2">
                  <legend class="text-[11px] font-semibold uppercase tracking-wider text-stone-600">
                    3. Target Glaze Surface
                  </legend>
                  <div class="grid grid-cols-2 gap-2">
                    <% [ [ "gloss", "Gloss", "Si:Al 6.5–10.0" ], [ "matte", "Matte", "Si:Al 4.5–6.8" ] ].each do |surface_val, title, subtitle| %>
                      <label class="relative flex flex-col rounded-xl border border-[#D6C7B2] bg-[#FAF7F2] px-3 py-2.5 cursor-pointer hover:border-[#B84A27] has-[:checked]:border-[#B84A27] has-[:checked]:bg-[#B84A27]/10 transition-colors">
                        <input
                          type="radio"
                          name="surface"
                          value="<%= surface_val %>"
                          <%= "checked" if @surface == surface_val %>
                          class="sr-only"
                        >
                        <span class="text-xs font-bold text-stone-900"><%= title %></span>
                        <span class="text-[10px] font-mono text-stone-500"><%= subtitle %></span>
                      </label>
                    <% end %>
                  </div>
                </fieldset>

                <%# Optional Custom Recipe Name %>
                <div>
                  <%= form.label :recipe_title, "Recipe Title (Optional)", class: "block text-[11px] font-semibold uppercase tracking-wider text-stone-600 mb-1.5" %>
                  <%= form.text_field :recipe_title,
                    value: @recipe_title,
                    placeholder: "e.g. Puget Wild Clay Ash Celadon",
                    class: "w-full rounded-xl border border-[#D6C7B2] bg-white px-3 py-2 text-xs text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-[#1E4E79]/40 focus:border-[#1E4E79]" %>
                </div>

                <%= form.submit "Calculate Optimal Glaze Blend",
                  class: "w-full py-2.5 px-4 rounded-xl bg-[#1E4E79] hover:bg-[#163B5C] text-white text-xs sm:text-sm font-semibold shadow-sm transition-colors cursor-pointer" %>
              <% end %>
            <% else %>
              <div class="rounded-xl border border-dashed border-[#D6C7B2] bg-[#FAF7F2] p-5 text-center space-y-3">
                <p class="text-sm font-semibold text-stone-800">No assayed samples saved yet</p>
                <p class="text-xs text-stone-600">
                  Create and save at least 2 local material samples in DCI Tailor so they have chemical oxide assays ready to blend.
                </p>
                <%= link_to "+ Create First Sample",
                  new_sample_path,
                  class: "inline-flex items-center px-3.5 py-2 rounded-xl bg-[#B84A27] hover:bg-[#963B1D] text-white text-xs font-semibold transition-colors" %>
              </div>
            <% end %>
          </div>
        </section>

        <%# RIGHT COLUMN: Live Blend Calculation Results (Turbo Frame / Stream Target) %>
        <section class="lg:col-span-8 min-w-0">
          <%= render "blends/results",
            blend_result: @blend_result,
            error_message: @error_message,
            recipe_title: @recipe_title,
            available_samples: @available_samples %>
        </section>
      </div>
    </div>
  </main>
</div>
