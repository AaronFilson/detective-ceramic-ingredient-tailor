<% if authenticated? %>
  <div class="inline-flex items-center gap-1.5" data-auth-controls="authenticated">
    <span class="hidden sm:inline-flex items-center px-2.5 py-1 rounded-lg bg-stone-800/90 border border-stone-700 text-amber-200 text-xs font-medium truncate max-w-[160px]" title="<%= current_user.email %>">
      <%= current_user.name.presence || current_user.email %>
    </span>
    <%= button_to "Sign Out",
      session_path,
      method: :delete,
      form: { class: "inline" },
      class: "inline-flex items-center px-2.5 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-300 hover:text-white border border-stone-700 text-xs font-medium transition-colors cursor-pointer" %>
  </div>
<% else %>
  <div class="inline-flex items-center gap-1.5" data-auth-controls="guest">
    <span class="hidden md:inline-flex items-center px-2 py-0.5 rounded-full bg-stone-800/80 border border-stone-700 text-stone-300 font-mono text-[10px] uppercase tracking-wider">
      Guest Sandbox
    </span>
    <%= link_to "Sign In",
      new_session_path,
      class: "inline-flex items-center px-2.5 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-amber-200 hover:text-amber-100 border border-stone-700 text-xs font-medium transition-colors" %>
  </div>
<% end %>
