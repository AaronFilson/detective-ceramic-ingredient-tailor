# Staging secrets for Kamal (`bin/kamal deploy -d staging`).
# Reads isolated staging secrets from `/dci-tailor/staging/*` when AWS_REGION is set,
# with clean env-var fallbacks so `bundle exec kamal config -d staging` works offline.

KAMAL_REGISTRY_PASSWORD=$(if [ -n "\${KAMAL_REGISTRY_PASSWORD:-}" ]; then printf '%s' "\$KAMAL_REGISTRY_PASSWORD"; elif [ -n "\${GITHUB_TOKEN:-}" ]; then printf '%s' "\$GITHUB_TOKEN"; else printf 'local-registry-token'; fi)
SECRET_KEY_BASE=$(if [ -n "\${SECRET_KEY_BASE:-}" ]; then printf '%s' "\$SECRET_KEY_BASE"; elif [ -n "\${AWS_REGION:-}" ]; then aws ssm get-parameter --region "\$AWS_REGION" --with-decryption --name /dci-tailor/staging/secret-key-base --query Parameter.Value --output text; else printf 'local-staging-secret-key-base'; fi)
POSTGRES_PASSWORD=$(if [ -n "\${POSTGRES_PASSWORD:-}" ]; then printf '%s' "\$POSTGRES_PASSWORD"; elif [ -n "\${AWS_REGION:-}" ]; then aws ssm get-parameter --region "\$AWS_REGION" --with-decryption --name /dci-tailor/staging/postgres-password --query Parameter.Value --output text; else printf 'local-staging-postgres-password'; fi)
AWS_S3_BUCKET=$(if [ -n "\${AWS_S3_BUCKET:-}" ]; then printf '%s' "\$AWS_S3_BUCKET"; elif [ -n "\${AWS_REGION:-}" ]; then aws ssm get-parameter --region "\$AWS_REGION" --name /dci-tailor/staging/storage-bucket --query Parameter.Value --output text; else printf 'dci-tailor-staging-storage-724654236968'; fi)
AWS_ACCESS_KEY_ID=$(if [ -n "\${AWS_ACCESS_KEY_ID:-}" ]; then printf '%s' "\$AWS_ACCESS_KEY_ID"; elif [ -n "\${AWS_REGION:-}" ]; then aws ssm get-parameter --region "\$AWS_REGION" --with-decryption --name /dci-tailor/staging/aws-access-key-id --query Parameter.Value --output text; else printf 'local-staging-aws-access-key-id'; fi)
AWS_SECRET_ACCESS_KEY=$(if [ -n "\${AWS_SECRET_ACCESS_KEY:-}" ]; then printf '%s' "\$AWS_SECRET_ACCESS_KEY"; elif [ -n "\${AWS_REGION:-}" ]; then aws ssm get-parameter --region "\$AWS_REGION" --with-decryption --name /dci-tailor/staging/aws-secret-access-key --query Parameter.Value --output text; else printf 'local-staging-aws-secret-access-key'; fi)
SMTP_URL=$(if [ -n "\${SMTP_URL:-}" ]; then printf '%s' "\$SMTP_URL"; elif [ -n "\${AWS_REGION:-}" ]; then aws ssm get-parameter --region "\$AWS_REGION" --with-decryption --name /dci-tailor/staging/smtp-url --query Parameter.Value --output text 2>/dev/null || true; else printf ''; fi)
MINDAT_API_TOKEN=$(if [ -n "\${MINDAT_API_TOKEN:-}" ]; then printf '%s' "\$MINDAT_API_TOKEN"; elif [ -n "\${AWS_REGION:-}" ]; then aws ssm get-parameter --region "\$AWS_REGION" --with-decryption --name /dci-tailor/staging/mindat-api-token --query Parameter.Value --output text 2>/dev/null || true; else printf ''; fi)
GEOROC_API_KEY=$(if [ -n "\${GEOROC_API_KEY:-}" ]; then printf '%s' "\$GEOROC_API_KEY"; elif [ -n "\${AWS_REGION:-}" ]; then aws ssm get-parameter --region "\$AWS_REGION" --with-decryption --name /dci-tailor/staging/georoc-api-key --query Parameter.Value --output text 2>/dev/null || true; else printf ''; fi)
